# Arch
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_DIWALI is not set
# CONFIG_ARCH_CAPE is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_PCIE_KIRIN is not set
# CONFIG_INTERCONNECT_QCOM_DIWALI is not set
# CONFIG_INTERCONNECT_QCOM_PARROT is not set

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_ET6XX=y

# Touchscreen
# CONFIG_TOUCHSCREEN_ATMEL_MXT is not set
# CONFIG_TOUCHSCREEN_FTS is not set
# CONFIG_FTS_TRUSTED_TOUCH is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX is not set
# CONFIG_TOUCHSCREEN_NT36XXX_I2C is not set
# CONFIG_NOVATEK_TRUSTED_TOUCH is not set
# CONFIG_TOUCHSCREEN_NT36XXX_SPI is not set
# CONFIG_TOUCHSCREEN_GOODIX_BRL is not set
CONFIG_TOUCHSCREEN_SEC_TS=y

# from regular GKI
CONFIG_USB_DWC3_HAPS=y
CONFIG_USB_DWC3_OF_SIMPLE=y
CONFIG_USB_DWC3_QCOM=y
