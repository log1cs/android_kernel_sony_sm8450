CONFIG_BUILD_ARM64_DT_OVERLAY=y

CONFIG_LOG_BUF_SHIFT=21

# from regular GKI
CONFIG_USB_DWC3_HAPS=y
CONFIG_USB_DWC3_OF_SIMPLE=y
CONFIG_USB_DWC3_QCOM=y

CONFIG_DEBUG_FS=y
CONFIG_DYNAMIC_DEBUG=y

# Disable unused touchscreen drivers
CONFIG_FTS_TRUSTED_TOUCH=n
CONFIG_NOVATEK_TRUSTED_TOUCH=n
CONFIG_TOUCHSCREEN_ATMEL_MXT=n
CONFIG_TOUCHSCREEN_FTS=n
# CONFIG_TOUCHSCREEN_FTS_DIRECTORY is not set
CONFIG_TOUCHSCREEN_GOODIX_BRL=n
CONFIG_TOUCHSCREEN_NT36XXX_I2C=n
CONFIG_TOUCHSCREEN_NT36XXX_SPI=n
CONFIG_TOUCHPANEL_SYNAPTICS=n
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX=n
